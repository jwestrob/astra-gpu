+/* Canonical generation marker for every pipeline option that can affect the
+ * filter replay, domain/hit construction, sorting key, or report/include tail.
+ * Dynamic Z/domZ values are intentionally omitted while HMMER owns them via
+ * p7_ZSETBY_NTARGETS; p7_pli_NewSeq() changes Z for every target. */
+uint64_t
+p7_pipeline_CompactTailFingerprint(const P7_PIPELINE *pli)
+{
+  union { double value; uint64_t bits; } d;
+  union { float value; uint32_t bits; } f;
+  uint64_t hash = UINT64_C(1469598103934665603);
+  uint64_t value;
+  int byte;
+
+#define HASH_U64(v) do {                                                       \
+    value = (uint64_t) (v);                                                    \
+    for (byte = 0; byte < 8; byte++) {                                         \
+      hash ^= value & UINT64_C(0xff);                                          \
+      hash *= UINT64_C(1099511628211);                                         \
+      value >>= 8;                                                             \
+    }                                                                          \
+  } while (0)
+#define HASH_I32(v) HASH_U64((uint32_t) (v))
+#define HASH_DOUBLE(v) do { d.value = (v); HASH_U64(d.bits); } while (0)
+#define HASH_FLOAT(v)  do { f.value = (v); HASH_U64(f.bits); } while (0)
+
+  if (pli == NULL || pli->ddef == NULL) return 0;
+  HASH_U64(UINT64_C(0x5044435441494c31)); /* "PDCTAIL1" */
+  HASH_DOUBLE(pli->F1);       HASH_DOUBLE(pli->F2);
+  HASH_DOUBLE(pli->F3);       HASH_DOUBLE(pli->E);
+  HASH_DOUBLE(pli->domE);     HASH_DOUBLE(pli->incE);
+  HASH_DOUBLE(pli->incdomE);
+  if (pli->use_bit_cutoffs == FALSE)
+    {
+      HASH_DOUBLE(pli->T);       HASH_DOUBLE(pli->domT);
+      HASH_DOUBLE(pli->incT);    HASH_DOUBLE(pli->incdomT);
+    }
+  else HASH_U64(UINT64_C(0x4355544f46465331)); /* "CUTOFFS1" */
+  if (pli->Z_setby != p7_ZSETBY_NTARGETS) HASH_DOUBLE(pli->Z);
+  else HASH_U64(UINT64_C(0x44594e414d49435a));
+  if (pli->domZ_setby != p7_ZSETBY_NTARGETS) HASH_DOUBLE(pli->domZ);
+  else HASH_U64(UINT64_C(0x44594e444f4d5a31));
+  HASH_FLOAT(pli->ddef->rt1); HASH_FLOAT(pli->ddef->rt2);
+  HASH_FLOAT(pli->ddef->rt3);
+  HASH_I32(pli->ddef->nsamples);
+  HASH_FLOAT(pli->ddef->min_overlap);
+  HASH_I32(pli->ddef->of_smaller);
+  HASH_I32(pli->ddef->max_diagdiff);
+  HASH_FLOAT(pli->ddef->min_posterior);
+  HASH_FLOAT(pli->ddef->min_endpointp);
+  HASH_I32(pli->ddef->do_reseeding);
+  HASH_I32(pli->do_reseeding); HASH_I32(pli->do_max);
+  HASH_I32(pli->B1); HASH_I32(pli->B2); HASH_I32(pli->B3);
+  HASH_I32(pli->do_biasfilter); HASH_I32(pli->do_null2);
+  HASH_I32(pli->do_alignment_score_calc);
+  HASH_I32(pli->by_E);       HASH_I32(pli->dom_by_E);
+  HASH_I32(pli->inc_by_E);   HASH_I32(pli->incdom_by_E);
+  HASH_I32(pli->use_bit_cutoffs);
+  HASH_I32(pli->Z_setby);    HASH_I32(pli->domZ_setby);
+  HASH_I32(pli->mode);       HASH_I32(pli->long_targets);
+  HASH_I32(pli->show_accessions); HASH_I32(pli->show_alignments);
+
+#undef HASH_FLOAT
+#undef HASH_DOUBLE
+#undef HASH_I32
+#undef HASH_U64
+  return hash;
+}
