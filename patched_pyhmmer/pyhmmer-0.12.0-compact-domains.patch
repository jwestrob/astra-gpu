+/* Model cutoffs are loaded by p7_pli_NewModel(). They are derived from the
+ * profile identity rather than user-owned generation options, so the option
+ * fingerprint uses a marker and this check independently attests the live
+ * threshold values. */
+static int
+pipeline_compact_model_cutoffs_are_exact(const P7_PIPELINE *pli,
+                                         const P7_OPROFILE *om)
+{
+  int target_cutoff;
+  int domain_cutoff;
+
+  if (pli == NULL || om == NULL) return FALSE;
+  if (pli->use_bit_cutoffs == FALSE) return TRUE;
+  if      (pli->use_bit_cutoffs == p7H_GA)
+    { target_cutoff = p7_GA1; domain_cutoff = p7_GA2; }
+  else if (pli->use_bit_cutoffs == p7H_TC)
+    { target_cutoff = p7_TC1; domain_cutoff = p7_TC2; }
+  else if (pli->use_bit_cutoffs == p7H_NC)
+    { target_cutoff = p7_NC1; domain_cutoff = p7_NC2; }
+  else return FALSE;
+
+  if (! isfinite(om->cutoff[target_cutoff]) ||
+      ! isfinite(om->cutoff[domain_cutoff]) ||
+      om->cutoff[target_cutoff] == p7_CUTOFF_UNSET ||
+      om->cutoff[domain_cutoff] == p7_CUTOFF_UNSET)
+    return FALSE;
+  return pli->T       == (double) om->cutoff[target_cutoff] &&
+         pli->incT    == (double) om->cutoff[target_cutoff] &&
+         pli->domT    == (double) om->cutoff[domain_cutoff] &&
+         pli->incdomT == (double) om->cutoff[domain_cutoff];
