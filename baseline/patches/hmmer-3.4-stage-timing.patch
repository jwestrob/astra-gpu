+/* Run one target through the ordinary protein pipeline. The wrapper keeps
+ * reconfiguration and whole-pipeline timing outside p7_Pipeline(), whose
+ * early filter returns would otherwise require invasive control-flow edits.
+ */
+static void
+pipeline_sequence(P7_PIPELINE *pli, P7_OPROFILE *om, P7_BG *bg, ESL_SQ *sq, P7_TOPHITS *th)
+{
+  uint64_t stage_started_ns;
+
+  p7_pli_NewSeq(pli, sq);
+
+  stage_started_ns = p7_stage_timing_Start(&pli->stage_timing);
+  p7_bg_SetLength(bg, sq->n);
+  p7_oprofile_ReconfigLength(om, sq->n);
+  p7_stage_timing_Stop(&pli->stage_timing, p7STAGE_RECONFIG, stage_started_ns);
+
+  stage_started_ns = p7_stage_timing_Start(&pli->stage_timing);
+  p7_Pipeline(pli, om, bg, sq, NULL, th);
+  p7_stage_timing_Stop(&pli->stage_timing, p7STAGE_PIPELINE, stage_started_ns);
+}
