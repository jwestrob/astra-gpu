+/* Enable cumulative stage timing for this pipeline. Timing is opt-in so the
+ * ordinary HMMER path does not call the clock. The MSV observer lives on the
+ * pipeline's private one-row matrix, which also keeps threaded workers
+ * independent.
+ */
+int
+p7_pipeline_EnableStageTiming(P7_PIPELINE *pli)
+{
+  memset(&pli->stage_timing, 0, sizeof(pli->stage_timing));
+  pli->stage_timing.enabled = TRUE;
+  pli->oxf->stage_timing    = &pli->stage_timing;
+  return eslOK;
+}
