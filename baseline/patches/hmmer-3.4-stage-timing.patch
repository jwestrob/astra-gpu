--- /dev/null
+++ b/src/p7_stage_timing.h
@@ -0,0 +1,88 @@
+/* Internal helpers for opt-in pipeline stage timing. */
+#ifndef P7_STAGE_TIMING_INCLUDED
+#define P7_STAGE_TIMING_INCLUDED
+
+#include <stdint.h>
+#include <time.h>
+
+#include "hmmer.h"
+
+static inline const char *
+p7_stage_timing_ClockName(void)
+{
+#if defined(CLOCK_MONOTONIC_RAW)
+  return "CLOCK_MONOTONIC_RAW";
+#elif defined(CLOCK_MONOTONIC)
+  return "CLOCK_MONOTONIC";
+#else
+  return "unavailable";
+#endif
+}
+
+static inline uint64_t
+p7_stage_timing_Now(P7_STAGE_TIMING *timing)
+{
+  struct timespec ts;
+  uint64_t        now_ns;
+#if defined(CLOCK_MONOTONIC_RAW)
+  const clockid_t clock_id = CLOCK_MONOTONIC_RAW;
+#elif defined(CLOCK_MONOTONIC)
+  const clockid_t clock_id = CLOCK_MONOTONIC;
+#else
+  timing->clock_errors++;
+  return 0;
+#endif
+
+  if (clock_gettime(clock_id, &ts) != 0)
+    {
+      timing->clock_errors++;
+      return 0;
+    }
+  now_ns = (uint64_t) ts.tv_sec * UINT64_C(1000000000) + (uint64_t) ts.tv_nsec;
+  if (now_ns == 0) timing->clock_errors++;
+  return now_ns;
+}
+
+static inline uint64_t
+p7_stage_timing_Start(P7_STAGE_TIMING *timing)
+{
+  return (timing != NULL && timing->enabled) ? p7_stage_timing_Now(timing) : 0;
+}
+
+static inline void
+p7_stage_timing_Stop(P7_STAGE_TIMING *timing, enum p7_stage_e stage, uint64_t started_ns)
+{
+  uint64_t stopped_ns;
+
+  if (timing == NULL || ! timing->enabled) return;
+  timing->stage[stage].calls++;
+  stopped_ns = p7_stage_timing_Now(timing);
+  if (started_ns == 0 || stopped_ns == 0) return; /* failing read already counted at its source */
+  if (stopped_ns < started_ns)
+    {
+      timing->clock_errors++;
+      return;
+    }
+  timing->stage[stage].elapsed_ns += stopped_ns - started_ns;
+}
+
+static inline void
+p7_stage_timing_CountSSVStatus(P7_STAGE_TIMING *timing, int status)
+{
+  if (timing == NULL || ! timing->enabled) return;
+  if      (status == eslOK)       timing->ssv_status_ok++;
+  else if (status == eslERANGE)   timing->ssv_status_erange++;
+  else if (status == eslENORESULT) timing->ssv_status_noresult++;
+  else                             timing->ssv_status_other++;
+}
+
+static inline void
+p7_stage_timing_CountFallbackStatus(P7_STAGE_TIMING *timing, int status)
+{
+  if (timing == NULL || ! timing->enabled) return;
+  if      (status == eslOK)     timing->fallback_status_ok++;
+  else if (status == eslERANGE) timing->fallback_status_erange++;
+  else                          timing->fallback_status_other++;
+}
+
+#endif /*P7_STAGE_TIMING_INCLUDED*/
