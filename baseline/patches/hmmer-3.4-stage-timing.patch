+/* Machine-readable, long-form timing output. Status, survival, and input
+ * rows are count-only and therefore have elapsed_ns=0.
+ */
+int
+p7_pli_StageTimingHeader(FILE *ofp)
+{
+  if (fprintf(ofp, "schema_version\tclock\tquery_index\tquery\tmetric\tcount\telapsed_ns\n") < 0)
+    ESL_EXCEPTION_SYS(eslEWRITE, "stage timing header write failed");
+  return eslOK;
+}
+
+int
+p7_pli_StageTiming(FILE *ofp, const P7_PIPELINE *pli, uint64_t query_index, const char *query_name)
+{
+  static const char *stage_name[p7STAGE_N] = {
+    "target_reconfig",
+    "pipeline_total",
+    "null1",
+    "msv_public",
+    "msv_ssv_attempt",
+    "msv_classic_fallback",
+    "bias_filter",
+    "viterbi_filter",
+    "forward_parser",
+    "backward_parser",
+    "domain_workflow"
+  };
+  const char *clock_name = p7_stage_timing_ClockName();
+  int s;
+
+#define P7_TIMING_ROW(metric, count, elapsed) do {                                                \
+    if (fprintf(ofp, "1\t%s\t%" PRIu64 "\t%s\t%s\t%" PRIu64 "\t%" PRIu64 "\n",            \
+                clock_name, query_index, query_name, (metric),                                  \
+                (uint64_t) (count), (uint64_t) (elapsed)) < 0)                                  \
+      ESL_EXCEPTION_SYS(eslEWRITE, "stage timing data write failed");                            \
+  } while (0)
+
+  for (s = 0; s < p7STAGE_N; s++)
+    P7_TIMING_ROW(stage_name[s], pli->stage_timing.stage[s].calls, pli->stage_timing.stage[s].elapsed_ns);
+
+  P7_TIMING_ROW("clock_errors",                  pli->stage_timing.clock_errors,           0);
+  P7_TIMING_ROW("msv_ssv_status_ok",             pli->stage_timing.ssv_status_ok,          0);
+  P7_TIMING_ROW("msv_ssv_status_erange",         pli->stage_timing.ssv_status_erange,      0);
+  P7_TIMING_ROW("msv_ssv_status_noresult",       pli->stage_timing.ssv_status_noresult,    0);
+  P7_TIMING_ROW("msv_ssv_status_other",          pli->stage_timing.ssv_status_other,       0);
+  P7_TIMING_ROW("msv_fallback_status_ok",        pli->stage_timing.fallback_status_ok,      0);
+  P7_TIMING_ROW("msv_fallback_status_erange",    pli->stage_timing.fallback_status_erange,  0);
+  P7_TIMING_ROW("msv_fallback_status_other",     pli->stage_timing.fallback_status_other,   0);
+  P7_TIMING_ROW("target_sequences",              pli->nseqs,                                0);
+  P7_TIMING_ROW("target_residues",               pli->nres,                                 0);
+  P7_TIMING_ROW("passed_msv",                    pli->n_past_msv,                           0);
+  P7_TIMING_ROW("passed_bias",                   pli->n_past_bias,                          0);
+  P7_TIMING_ROW("passed_viterbi",                pli->n_past_vit,                           0);
+  P7_TIMING_ROW("passed_forward",                pli->n_past_fwd,                           0);
+
+#undef P7_TIMING_ROW
+
+  if (fflush(ofp) != 0) ESL_EXCEPTION_SYS(eslEWRITE, "stage timing flush failed");
+  return eslOK;
+}
